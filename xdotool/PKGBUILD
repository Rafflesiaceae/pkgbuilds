package() {
  cd $pkgname-$pkgver
  make DESTDIR="$pkgdir" PREFIX=/usr INSTALLMAN=/usr/share/man install
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" COPYRIGHT
}
