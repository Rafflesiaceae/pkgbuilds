From e12554d2a47fdd6f467975dda74755f662508267 Mon Sep 17 00:00:00 2001
From: Codex <codex@localhost>
Date: Sun, 13 Sep 2026 08:41:06 +0200
Subject: [PATCH 3/3] Pause X11 property events while the frame is hidden

i3 can repeatedly update frame properties during unrelated rendering activity.
GTK wakes for every PropertyNotify even when pavucontrol's frame is not
viewable.

Temporarily remove PropertyChangeMask from GTK's X11 event selection while
hidden and restore the original mask before the frame becomes visible again.
---
 src/x11visibilitymonitor.cc | 24 ++++++++++++++++++++++++
 1 file changed, 24 insertions(+)

diff --git a/src/x11visibilitymonitor.cc b/src/x11visibilitymonitor.cc
index 41a43b1..65c1b7d 100644
--- a/src/x11visibilitymonitor.cc
+++ b/src/x11visibilitymonitor.cc
@@ -37,9 +37,18 @@ struct X11VisibilityMonitor::Impl {
             gdkDisplay, "xevent", G_CALLBACK(onXEvent), this);
         updateFrameWindow();
         visible = queryVisible();
+
+        XWindowAttributes attributes;
+        if (XGetWindowAttributes(xdisplay, clientWindow, &attributes)) {
+            gdkEventMask = attributes.your_event_mask;
+            haveGdkEventMask = true;
+            setGdkPropertyEventsEnabled(visible);
+        }
     }

     ~Impl() {
+        setGdkPropertyEventsEnabled(true);
+
         if (xeventHandler)
             g_signal_handler_disconnect(gdkDisplay, xeventHandler);

@@ -57,6 +66,18 @@ struct X11VisibilityMonitor::Impl {
     }

 private:
+    void setGdkPropertyEventsEnabled(bool enabled) {
+        if (!haveGdkEventMask)
+            return;
+
+        /* Some window managers repeatedly update frame properties even while
+         * the frame is unmapped. GTK does not need those notifications until
+         * the frame becomes visible again. */
+        const long mask = enabled ? gdkEventMask : (gdkEventMask & ~PropertyChangeMask);
+        XSelectInput(xdisplay, clientWindow, mask);
+        XFlush(xdisplay);
+    }
+
     static gboolean onXEvent(GdkDisplay *, XEvent *event, gpointer data) {
         return static_cast<Impl *>(data)->handleXEvent(*event);
     }
@@ -145,6 +166,7 @@ private:
             return;

         visible = newVisible;
+        setGdkPropertyEventsEnabled(visible);
         visibilityChanged();
     }

@@ -153,7 +175,9 @@ private:
     Window clientWindow = None;
     Window frameWindow = None;
     long frameEventMask = 0;
+    long gdkEventMask = 0;
     bool haveFrameEventMask = false;
+    bool haveGdkEventMask = false;
     bool visible = false;
     std::function<void()> visibilityChanged;
     gulong xeventHandler = 0;
