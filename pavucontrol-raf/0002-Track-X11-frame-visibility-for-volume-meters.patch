diff --git a/src/x11visibilitymonitor.cc b/src/x11visibilitymonitor.cc
new file mode 100644
index 0000000..41a43b1
--- /dev/null
+++ b/src/x11visibilitymonitor.cc
@@ -0,0 +1,180 @@
+/***
+  This file is part of pavucontrol.
+
+  pavucontrol is free software; you can redistribute it and/or modify
+  it under the terms of the GNU General Public License as published by
+  the Free Software Foundation, either version 2 of the License, or
+  (at your option) any later version.
+***/
+
+#include "x11visibilitymonitor.h"
+
+#include <utility>
+
+#include <gdk/x11/gdkx.h>
+#include <gdkmm/display.h>
+
+struct X11VisibilityMonitor::Impl {
+    Impl(const Glib::RefPtr<Gdk::Surface>& surface, std::function<void()> visibilityChanged) :
+        visibilityChanged(std::move(visibilityChanged)) {
+        const auto display = surface->get_display();
+        if (!display || !GDK_IS_X11_SURFACE(surface->gobj()))
+            return;
+
+        gdkDisplay = display->gobj();
+
+        G_GNUC_BEGIN_IGNORE_DEPRECATIONS
+        xdisplay = gdk_x11_display_get_xdisplay(GDK_X11_DISPLAY(gdkDisplay));
+        clientWindow = gdk_x11_surface_get_xid(GDK_X11_SURFACE(surface->gobj()));
+        G_GNUC_END_IGNORE_DEPRECATIONS
+
+        if (!xdisplay || clientWindow == None) {
+            xdisplay = nullptr;
+            return;
+        }
+
+        xeventHandler = g_signal_connect(
+            gdkDisplay, "xevent", G_CALLBACK(onXEvent), this);
+        updateFrameWindow();
+        visible = queryVisible();
+    }
+
+    ~Impl() {
+        if (xeventHandler)
+            g_signal_handler_disconnect(gdkDisplay, xeventHandler);
+
+        restoreFrameEventMask();
+        if (xdisplay)
+            XFlush(xdisplay);
+    }
+
+    bool valid() const {
+        return xdisplay != nullptr;
+    }
+
+    bool isVisible() const {
+        return visible;
+    }
+
+private:
+    static gboolean onXEvent(GdkDisplay *, XEvent *event, gpointer data) {
+        return static_cast<Impl *>(data)->handleXEvent(*event);
+    }
+
+    gboolean handleXEvent(const XEvent& event) {
+        bool visibilityMayHaveChanged = false;
+
+        switch (event.type) {
+            case ReparentNotify:
+                if (event.xreparent.window == clientWindow) {
+                    updateFrameWindow();
+                    visibilityMayHaveChanged = true;
+                }
+                break;
+
+            case MapNotify:
+                visibilityMayHaveChanged =
+                    event.xmap.window == clientWindow || event.xmap.window == frameWindow;
+                break;
+
+            case UnmapNotify:
+                visibilityMayHaveChanged =
+                    event.xunmap.window == clientWindow || event.xunmap.window == frameWindow;
+                break;
+
+            case DestroyNotify:
+                if (event.xdestroywindow.window == frameWindow) {
+                    frameWindow = None;
+                    haveFrameEventMask = false;
+                    updateFrameWindow();
+                    visibilityMayHaveChanged = true;
+                }
+                break;
+        }
+
+        if (visibilityMayHaveChanged)
+            updateVisibility();
+
+        return false;
+    }
+
+    void restoreFrameEventMask() {
+        if (frameWindow != None && haveFrameEventMask)
+            XSelectInput(xdisplay, frameWindow, frameEventMask);
+
+        frameWindow = None;
+        haveFrameEventMask = false;
+    }
+
+    void updateFrameWindow() {
+        Window root = None;
+        Window parent = None;
+        Window *children = nullptr;
+        unsigned int childCount = 0;
+
+        if (!XQueryTree(xdisplay, clientWindow, &root, &parent, &children, &childCount))
+            return;
+
+        if (children)
+            XFree(children);
+
+        if (parent == frameWindow)
+            return;
+
+        restoreFrameEventMask();
+        frameWindow = parent;
+
+        XWindowAttributes attributes;
+        if (frameWindow != None && XGetWindowAttributes(xdisplay, frameWindow, &attributes)) {
+            frameEventMask = attributes.your_event_mask;
+            haveFrameEventMask = true;
+            XSelectInput(xdisplay, frameWindow, frameEventMask | StructureNotifyMask);
+            XFlush(xdisplay);
+        }
+    }
+
+    bool queryVisible() const {
+        XWindowAttributes attributes;
+        return XGetWindowAttributes(xdisplay, clientWindow, &attributes) &&
+               attributes.map_state == IsViewable;
+    }
+
+    void updateVisibility() {
+        const bool newVisible = queryVisible();
+        if (newVisible == visible)
+            return;
+
+        visible = newVisible;
+        visibilityChanged();
+    }
+
+    GdkDisplay *gdkDisplay = nullptr;
+    Display *xdisplay = nullptr;
+    Window clientWindow = None;
+    Window frameWindow = None;
+    long frameEventMask = 0;
+    bool haveFrameEventMask = false;
+    bool visible = false;
+    std::function<void()> visibilityChanged;
+    gulong xeventHandler = 0;
+};
+
+std::unique_ptr<X11VisibilityMonitor> X11VisibilityMonitor::create(
+        const Glib::RefPtr<Gdk::Surface>& surface,
+        std::function<void()> visibilityChanged) {
+    auto impl = std::make_unique<Impl>(surface, std::move(visibilityChanged));
+    if (!impl->valid())
+        return nullptr;
+
+    return std::unique_ptr<X11VisibilityMonitor>(new X11VisibilityMonitor(std::move(impl)));
+}
+
+X11VisibilityMonitor::X11VisibilityMonitor(std::unique_ptr<Impl> impl) :
+    impl(std::move(impl)) {
+}
+
+X11VisibilityMonitor::~X11VisibilityMonitor() = default;
+
+bool X11VisibilityMonitor::isVisible() const {
+    return impl->isVisible();
+}
diff --git a/src/x11visibilitymonitor.h b/src/x11visibilitymonitor.h
new file mode 100644
index 0000000..9af603a
--- /dev/null
+++ b/src/x11visibilitymonitor.h
@@ -0,0 +1,36 @@
+/***
+  This file is part of pavucontrol.
+
+  pavucontrol is free software; you can redistribute it and/or modify
+  it under the terms of the GNU General Public License as published by
+  the Free Software Foundation, either version 2 of the License, or
+  (at your option) any later version.
+***/
+
+#ifndef x11visibilitymonitor_h
+#define x11visibilitymonitor_h
+
+#include <functional>
+#include <memory>
+
+#include <gdkmm/surface.h>
+
+class X11VisibilityMonitor {
+public:
+    static std::unique_ptr<X11VisibilityMonitor> create(
+        const Glib::RefPtr<Gdk::Surface>& surface,
+        std::function<void()> visibilityChanged);
+
+    ~X11VisibilityMonitor();
+
+    bool isVisible() const;
+
+private:
+    struct Impl;
+
+    explicit X11VisibilityMonitor(std::unique_ptr<Impl> impl);
+
+    std::unique_ptr<Impl> impl;
+};
+
+#endif
