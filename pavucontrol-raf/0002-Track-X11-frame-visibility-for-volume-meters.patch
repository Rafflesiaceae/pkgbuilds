 src/mainwindow.cc           |   7 +-
 src/mainwindow.h            |   3 +
 src/meson.build             |   3 +-
 src/x11visibilitymonitor.cc | 180 ++++++++++++++++++++++++++++++++++++
 src/x11visibilitymonitor.h  |  36 ++++++++
 6 files changed, 228 insertions(+), 2 deletions(-)
 create mode 100644 src/x11visibilitymonitor.cc
 create mode 100644 src/x11visibilitymonitor.h

